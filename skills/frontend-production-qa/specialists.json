      "skill_ids": ["impeccable"],
      "repository": "pbakaus/impeccable",
      "channel": "provider-cli",
      "author_version": {
        "kind": "github-json",
        "url": "https://raw.githubusercontent.com/pbakaus/impeccable/main/package.json",
        "property": "version"
      },
      "distribution_version": {
        "kind": "json",
        "url": "https://registry.npmjs.org/impeccable/latest",
        "property": "version"
      },
      "local_version": {
        "kind": "skill-frontmatter",
        "property": "metadata.version"
      },
      "install": {
        "command": "npx impeccable install --providers=codex --scope=global"
      },
      "update": {
        "command": "npx impeccable update"
      },
      "fresh_session_required": true,
      "post_update_note": "Review /hooks in Codex after install/update because hook trust may change."
    },
